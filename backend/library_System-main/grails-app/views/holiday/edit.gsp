<!doctype html><html><head><meta name="layout" content="main"/><title>تعديل يوم التقويم</title></head><body><section class="mn-page"><div class="container"><div class="mn-page-head"><div><span class="mn-kicker">تقويم المكتبة</span><h1>تعديل ${holiday?.name}</h1><p>الحفظ يحول هذا اليوم إلى تعديل إداري، لذلك لن تستبدله المزامنة الخارجية تلقائيًا.</p></div></div>
<g:form action="update" id="${holiday?.id}" method="PUT"><div class="mn-form-section"><div class="row g-3"><div class="col-md-4 mn-field"><label>التاريخ</label><input type="date" class="form-control" name="holidayDate" value="${g.formatDate(date:holiday?.holidayDate,format:'yyyy-MM-dd')}" required/></div><div class="col-md-8 mn-field"><label>اسم المناسبة</label><input class="form-control" name="name" value="${holiday?.name}" required dir="auto"/></div></div><div class="mn-field"><label>ملاحظات</label><textarea class="form-control" name="notes" rows="4" dir="auto">${holiday?.notes ?: ''}</textarea></div><div class="form-check"><input class="form-check-input" type="checkbox" name="closed" value="true" id="closed" ${holiday?.closed?'checked':''}/><label class="form-check-label" for="closed">المكتبة مغلقة</label></div><div class="mn-form-actions"><button class="mn-btn mn-btn-primary">حفظ التعديل</button><g:link action="index" class="mn-btn mn-btn-light">رجوع</g:link></div></div></g:form>
<g:form action="delete" id="${holiday?.id}" method="DELETE" class="mt-3"><button class="mn-btn mn-btn-danger" data-confirm="حذف هذا اليوم من التقويم؟">حذف اليوم</button></g:form>
</div></section></body></html>
