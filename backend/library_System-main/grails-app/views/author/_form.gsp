<g:uploadForm action="${formAction}" id="${author?.id}" method="${formAction=='update'?'PUT':'POST'}">
<div class="mn-form-shell"><div>
<div class="mn-form-section"><h2>بيانات المؤلف</h2><p>الاسم يبقى بلغته الأصلية، بينما السيرة يمكن كتابتها بالعربية لسهولة القراءة داخل المكتبة.</p><div class="mn-field"><label>اسم المؤلف</label><input class="form-control" name="name" value="${author?.name ?: ''}" required dir="auto"/></div><div class="mn-field"><label>الجنسية / البلد</label><input class="form-control" name="nationality" value="${author?.nationality ?: ''}" dir="auto"/></div><div class="mn-field"><label>السيرة الذاتية</label><textarea class="form-control" name="biography" rows="8" dir="auto">${author?.biography ?: ''}</textarea></div></div>
<div class="mn-form-section"><h2>صورة المؤلف</h2><div class="mn-field"><label>رفع صورة</label><input type="file" name="imageFile" accept="image/*" class="form-control"/><div class="mn-help">JPG/PNG/WebP، ويفضل صورة مربعة. الحد الأقصى 5MB.</div></div><g:if test="${author?.imageData}"><div class="d-flex gap-3 align-items-center"><img src="${createLink(controller:'author',action:'photo',id:author.id)}" style="width:90px;height:90px;border-radius:50%;object-fit:cover"/><div class="form-check"><input class="form-check-input" type="checkbox" name="removeImage" value="true" id="removeAuthorImage"/><label class="form-check-label" for="removeAuthorImage">إزالة الصورة الحالية</label></div></div></g:if></div>
<div class="mn-form-actions"><button class="mn-btn mn-btn-primary">حفظ المؤلف</button><g:link action="${author?.id?'show':'index'}" id="${author?.id}" class="mn-btn mn-btn-light">إلغاء</g:link></div>
</div><aside class="mn-form-aside"><div class="mn-panel"><div class="mn-panel-body"><strong>عرض العلاقات</strong><p class="mn-muted mt-2 mb-0">في صفحات المؤلف ستظهر الكتب بأسمائها وأغلفتها، وليس كـ IDs أو كائنات تقنية.</p></div></div></aside></div></g:uploadForm>
