<!doctype html><html><head><meta name="layout" content="main"/><title>${author?.name} | المنارة</title></head><body><section class="mn-page"><div class="container"><div class="mn-page-head"><div><span class="mn-kicker">ملف مؤلف</span><h1 dir="auto">${author?.name}</h1></div><div class="mn-toolbar"><g:link action="index" class="mn-btn mn-btn-light">المؤلفون</g:link><sec:ifAnyGranted roles="ROLE_ADMIN"><g:link action="edit" id="${author.id}" class="mn-btn mn-btn-primary">تعديل</g:link></sec:ifAnyGranted></div></div>
<div class="mn-detail-hero"><div class="mn-detail-media author"><g:if test="${author.imageData}"><img src="${createLink(controller:'author',action:'photo',id:author.id)}" alt="${author.name}"/></g:if><g:else><span style="font-size:4rem">${author.name?.take(1)?.toUpperCase()}</span></g:else></div><div class="mn-detail-copy"><span class="mn-kicker">${author.nationality ?: 'مؤلف'}</span><h1 dir="auto">${author.name}</h1><p>${author.biography ?: 'لم تُضف سيرة ذاتية لهذا المؤلف بعد.'}</p><div class="mn-meta-row"><span class="mn-meta-chip">${bookList?.size() ?: 0} كتاب في المكتبة</span></div></div></div>
<div class="mt-4"><div class="mn-page-head mb-3"><div><span class="mn-kicker">أعماله</span><h2 class="h3">كتب في المنارة</h2></div></div><div class="mn-catalog-grid"><g:each in="${bookList}" var="book"><article class="mn-catalog-card"><div class="mn-room-image" style="aspect-ratio:4/3"><g:if test="${book.coverData || book.externalCoverUrl}"><img src="${createLink(controller:'book',action:'cover',id:book.id)}" alt="${book.title}"/></g:if><g:else><i class="bi bi-book"></i></g:else></div><div class="mn-room-card-body"><small class="mn-muted">${book.category?.name}</small><h3 dir="auto">${book.title}</h3><g:link controller="book" action="show" id="${book.id}" class="mn-btn mn-btn-light mn-btn-sm">تفاصيل الكتاب</g:link></div></article></g:each></div><g:if test="${!bookList}"><div class="mn-empty">لا توجد كتب مرتبطة بهذا المؤلف.</div></g:if></div>
<sec:ifAnyGranted roles="ROLE_ADMIN"><g:form action="delete" id="${author.id}" method="DELETE" class="mt-4"><button class="mn-btn mn-btn-danger" data-confirm="حذف المؤلف؟ لا يمكن الحذف إذا كانت هناك كتب مرتبطة به.">حذف المؤلف</button></g:form></sec:ifAnyGranted>
</div></section></body></html>
