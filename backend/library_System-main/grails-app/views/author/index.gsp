<!doctype html><html><head><meta name="layout" content="main"/><title>المؤلفون | المنارة</title></head><body><section class="mn-page"><div class="container"><div class="mn-page-head"><div><span class="mn-kicker">أصوات وراء الكتب</span><h1>المؤلفون</h1><p>تعرف على أصحاب الكتب من خلال سيرة مختصرة وأعمالهم الموجودة في المكتبة.</p></div><sec:ifAnyGranted roles="ROLE_ADMIN"><g:link action="create" class="mn-btn mn-btn-primary">إضافة مؤلف</g:link></sec:ifAnyGranted></div>
<div class="mn-catalog-grid"><g:each in="${authorList}" var="author"><article class="mn-catalog-card"><div class="mn-panel-body text-center"><div class="mx-auto mb-3" style="width:110px;height:110px;border-radius:50%;overflow:hidden;background:var(--sl-navy-900);display:flex;align-items:center;justify-content:center;color:white;font-size:2rem"><g:if test="${author.imageData}"><img src="${createLink(controller:'author',action:'photo',id:author.id)}" style="width:100%;height:100%;object-fit:cover" alt="${author.name}"/></g:if><g:else>${author.name?.take(1)?.toUpperCase()}</g:else></div><small class="mn-muted">${author.nationality ?: 'مؤلف'}</small><h2 class="h5 mt-1" dir="auto"><g:link action="show" id="${author.id}" class="text-dark">${author.name}</g:link></h2><p class="mn-muted small" style="min-height:72px">${author.biography ? (author.biography.size()>150 ? author.biography.take(150)+'…' : author.biography) : 'لم تُضف سيرة مختصرة بعد.'}</p><g:link action="show" id="${author.id}" class="mn-btn mn-btn-light mn-btn-sm">عرض الملف والكتب</g:link></div></article></g:each></div><g:if test="${!authorList}"><div class="mn-empty"><i class="bi bi-person-lines-fill"></i>لا يوجد مؤلفون بعد.</div></g:if><div class="mt-4"><g:paginate total="${authorCount ?: 0}" max="${params.int('max') ?: 12}"/></div>
</div></section></body></html>
