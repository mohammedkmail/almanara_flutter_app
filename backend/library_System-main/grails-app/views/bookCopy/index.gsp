<!doctype html><html><head><meta name="layout" content="main"/><title>نسخ الكتب | المنارة</title></head><body><section class="mn-page"><div class="container"><div class="mn-page-head"><div><span class="mn-kicker">مخزون الإعارة</span><h1>نسخ الكتب الفعلية</h1><p>هذه النسخ مخصصة للإعارة وليست مخزون البيع. حالات «مُعار» و«محجوز» يديرها النظام تلقائيًا.</p></div><g:link action="create" class="mn-btn mn-btn-primary">إضافة نسخة</g:link></div>
<div class="mn-panel"><div class="table-responsive"><table class="mn-data-table"><thead><tr><th>رمز النسخة</th><th>الكتاب</th><th>الحالة</th><th></th></tr></thead><tbody><g:each in="${bookCopyList}" var="c"><tr><td><strong dir="ltr">${c.copyCode}</strong></td><td><div class="mn-entity"><g:if test="${c.book?.coverData || c.book?.externalCoverUrl}"><img class="mn-entity-avatar" src="${createLink(controller:'book',action:'cover',id:c.book.id)}"/></g:if><div><strong dir="auto">${c.book?.title}</strong><small dir="auto">${c.book?.author?.name}</small></div></div></td><td><ui:status value="${c.status}"/></td><td><g:link action="show" id="${c.id}" class="mn-btn mn-btn-light mn-btn-sm">تفاصيل</g:link></td></tr></g:each><g:if test="${!bookCopyList}"><tr><td colspan="4" class="mn-empty">لا توجد نسخ إعارة بعد.</td></tr></g:if></tbody></table></div></div><div class="mt-4"><g:paginate total="${bookCopyCount ?: 0}" max="${pageSize ?: 20}"/></div></div></section></body></html>
