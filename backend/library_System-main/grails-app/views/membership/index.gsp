<!doctype html><html><head><meta name="layout" content="main"/><title>العضويات | المنارة</title></head><body><section class="mn-page"><div class="container"><div class="mn-page-head"><div><span class="mn-kicker">العضوية</span><h1>${isAdmin?'إدارة العضويات':'عضوياتي'}</h1><p>${isAdmin?'متابعة فترات العضوية والمدفوعات للمستخدمين.':'العضوية الفعالة تمنحك استعارة ورقية بدون رسوم ووصولًا للكتب الرقمية المشمولة، مع خصومات للمدد الأطول.'}</p></div><g:if test="${!isAdmin}"><g:link action="create" class="mn-btn mn-btn-primary">عضوية جديدة</g:link></g:if></div>
<div class="mn-panel"><div class="table-responsive"><table class="mn-data-table"><thead><tr><g:if test="${isAdmin}"><th>المستخدم</th></g:if><th>الفترة</th><th>السعر</th><th>الحالة</th><th></th></tr></thead><tbody><g:each in="${membershipList}" var="m"><tr><g:if test="${isAdmin}"><td dir="auto">${m.user?.fullName ?: m.user?.username}</td></g:if><td>${m.startDate ? g.formatDate(date: m.startDate, format: 'dd/MM/yyyy') : ''} — ${m.endDate ? g.formatDate(date: m.endDate, format: 'dd/MM/yyyy') : ''}</td><td><ui:money value="${m.price}"/></td><td><ui:status value="${m.status}"/></td><td><g:link action="show" id="${m.id}" class="mn-btn mn-btn-light mn-btn-sm">تفاصيل</g:link></td></tr></g:each><g:if test="${!membershipList}"><tr><td colspan="5" class="mn-empty">لا توجد عضويات بعد.</td></tr></g:if></tbody></table></div></div>
</div></section></body></html>
