<!doctype html><html><head><meta name="layout" content="main"/><title>حجوزات الكتب | المنارة</title></head><body><section class="mn-page"><div class="container"><div class="mn-page-head"><div><span class="mn-kicker">دور الاستعارة</span><h1>${isAdmin?'إدارة حجوزات الكتب':'حجوزاتي'}</h1><p>${isAdmin?'جهّز النسخ عند توفرها، ثم تابع الدفع والتسليم أو التوصيل.':'الحجز يحفظ دورك مجانًا. عند توفر نسخة، العضو الفعال يؤكد الاستعارة بدون رسوم، وغير العضو يكمل رسوم الاستعارة قبل الاستلام.'}</p></div><g:if test="${!isAdmin}"><g:link controller="book" action="index" class="mn-btn mn-btn-primary">استكشف الكتب</g:link></g:if></div>
<div class="mn-panel"><div class="table-responsive"><table class="mn-data-table"><thead><tr><g:if test="${isAdmin}"><th>المستخدم</th></g:if><th>الكتاب</th><th>النسخة</th><th>الحالة</th><th>التجهيز</th><th>تاريخ الطلب</th><th></th></tr></thead><tbody><g:each in="${reservationList}" var="r"><tr><g:if test="${isAdmin}"><td dir="auto">${r.user?.fullName ?: r.user?.username}</td></g:if><td><div class="mn-entity"><g:if test="${r.book?.coverData || r.book?.externalCoverUrl}"><img class="mn-entity-avatar" src="${createLink(controller:'book',action:'cover',id:r.book.id)}"/></g:if><div><strong dir="auto">${r.book?.title}</strong><small dir="auto">${r.book?.author?.name}</small></div></div></td><td>${r.assignedCopy?.copyCode ?: 'بانتظار نسخة'}</td><td><ui:status value="${r.status}"/></td><td><ui:label value="${r.fulfillmentStatus}"/></td><td>${r.reservationDate ? g.formatDate(date: r.reservationDate, format: 'dd/MM/yyyy HH:mm') : ''}</td><td><g:link action="show" id="${r.id}" class="mn-btn mn-btn-light mn-btn-sm">فتح</g:link></td></tr></g:each><g:if test="${!reservationList}"><tr><td colspan="7" class="mn-empty"><i class="bi bi-bookmark"></i>لا توجد حجوزات كتب بعد.</td></tr></g:if></tbody></table></div></div></div></section></body></html>
