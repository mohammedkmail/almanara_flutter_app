<g:uploadForm action="${formAction}" id="${studyRoom?.id}" method="${formAction=='update'?'PUT':'POST'}">
<div class="mn-form-shell"><div>
<div class="mn-form-section"><h2>بيانات الغرفة</h2><p>اسم واضح للمستخدم، ورقم داخلي للإدارة، مع وصف وتجهيزات تساعده يختار الغرفة المناسبة.</p><div class="row g-3"><div class="col-md-4 mn-field"><label>رقم الغرفة</label><input class="form-control" name="roomNumber" value="${studyRoom?.roomNumber ?: ''}" required dir="auto"/></div><div class="col-md-8 mn-field"><label>اسم الغرفة</label><input class="form-control" name="name" value="${studyRoom?.name ?: ''}" placeholder="مثال: غرفة القدس" dir="auto"/></div><div class="col-md-8 mn-field"><label>الموقع / الطابق</label><input class="form-control" name="location" value="${studyRoom?.location ?: ''}" placeholder="الطابق الثاني – الجناح الشرقي" dir="auto"/></div><div class="col-md-4 mn-field"><label>السعة</label><input type="number" min="1" class="form-control" name="capacity" value="${studyRoom?.capacity ?: 1}" required/></div><div class="col-md-4 mn-field"><label>السعر لكل ساعة</label><input type="number" min="0" step="0.01" class="form-control" name="pricePerHour" value="${studyRoom?.pricePerHour ?: 0}" required/></div><div class="col-12 mn-field"><label>الوصف</label><textarea class="form-control" name="description" rows="4" dir="auto">${studyRoom?.description ?: ''}</textarea></div><div class="col-12 mn-field"><label>التجهيزات</label><textarea class="form-control" name="features" rows="3" placeholder="شاشة عرض، Wi‑Fi، سبورة، مقابس كهرباء..." dir="auto">${studyRoom?.features ?: ''}</textarea></div></div><div class="form-check"><input class="form-check-input" type="checkbox" name="active" value="true" id="roomActive" ${studyRoom?.active != false?'checked':''}/><label class="form-check-label" for="roomActive">الغرفة متاحة للحجز</label></div></div>
<div class="mn-form-section"><h2>صورة الغرفة</h2><div class="mn-field"><label>رفع صورة</label><input type="file" name="imageFile" accept="image/*" class="form-control"/><div class="mn-help">JPG/PNG/WebP، حد أقصى 5MB.</div></div><g:if test="${studyRoom?.imageData}"><div class="d-flex align-items-center gap-3"><img src="${createLink(controller:'studyRoom',action:'photo',id:studyRoom.id)}" style="width:160px;height:100px;object-fit:cover;border-radius:12px"/><div class="form-check"><input type="checkbox" class="form-check-input" name="removeImage" value="true" id="removeRoomImage"/><label class="form-check-label" for="removeRoomImage">إزالة الصورة الحالية</label></div></div></g:if></div>
<div class="mn-form-actions"><button class="mn-btn mn-btn-primary">حفظ الغرفة</button><g:link action="${studyRoom?.id?'show':'index'}" id="${studyRoom?.id}" class="mn-btn mn-btn-light">إلغاء</g:link></div>
</div><aside class="mn-form-aside"><div class="mn-panel"><div class="mn-panel-body"><strong>كيف تظهر للمستخدم؟</strong><p class="mn-muted mt-2 mb-0">بطاقة بصورة واسم وسعة وموقع وتجهيزات وسعر الساعة. السعر النهائي والخصم يحسبان حسب مدة الحجز قبل الدفع.</p></div></div></aside></div></g:uploadForm>
