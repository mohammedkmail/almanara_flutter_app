<!doctype html><html><head><meta name="layout" content="main"/><title>${studyRoom?.displayName()} | المنارة</title></head><body><section class="mn-page"><div class="container"><div class="mn-page-head"><div><span class="mn-kicker">غرفة دراسة</span><h1 dir="auto">${studyRoom?.displayName()}</h1></div><div class="mn-toolbar"><g:link action="index" class="mn-btn mn-btn-light">كل الغرف</g:link><g:link action="edit" id="${studyRoom.id}" class="mn-btn mn-btn-primary">تعديل</g:link></div></div><div class="mn-detail-hero"><div class="mn-detail-media" style="aspect-ratio:16/10"><g:if test="${studyRoom.imageData}"><img src="${createLink(action:'photo',id:studyRoom.id)}" alt="${studyRoom.displayName()}"/></g:if><g:else><i class="bi bi-door-open fs-1"></i></g:else></div><div class="mn-detail-copy"><span class="mn-kicker">الغرفة ${studyRoom.roomNumber}</span><h1 dir="auto">${studyRoom.displayName()}</h1><p dir="auto">${studyRoom.description ?: 'لم يُضف وصف لهذه الغرفة بعد.'}</p><div class="mn-meta-row"><span class="mn-meta-chip"><i class="bi bi-people"></i> ${studyRoom.capacity} أشخاص</span><span class="mn-meta-chip"><ui:money value="${studyRoom.pricePerHour}"/> / ساعة</span><g:if test="${studyRoom.location}"><span class="mn-meta-chip"><i class="bi bi-geo-alt"></i> ${studyRoom.location}</span></g:if><span class="mn-meta-chip">${studyRoom.active?'متاحة للحجز':'معطلة'}</span></div><g:if test="${studyRoom.features}"><div class="mt-3"><small class="mn-muted">التجهيزات</small><p class="mb-0" dir="auto">${studyRoom.features}</p></div></g:if></div></div><g:form action="delete" id="${studyRoom.id}" method="DELETE" class="mt-4"><button class="mn-btn mn-btn-danger" data-confirm="حذف الغرفة؟ إذا كان لها سجل حجوزات سيتم تعطيلها بدل حذفها.">حذف / تعطيل</button></g:form></div></section></body></html>
