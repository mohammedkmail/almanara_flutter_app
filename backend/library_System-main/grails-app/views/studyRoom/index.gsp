<!doctype html><html><head><meta name="layout" content="main"/><title>غرف الدراسة | المنارة</title></head><body><section class="mn-page"><div class="container"><div class="mn-page-head"><div><span class="mn-kicker">إدارة الغرف</span><h1>غرف الدراسة</h1><p>تحكم بالسعة والسعر والتجهيزات والصور والتوفر من مكان واحد.</p></div><g:link action="create" class="mn-btn mn-btn-primary">إضافة غرفة</g:link></div><div class="mn-room-grid"><g:each in="${studyRoomList}" var="room"><article class="mn-room-card"><div class="mn-room-image"><g:if test="${room.imageData}"><img src="${createLink(action:'photo',id:room.id)}" alt="${room.displayName()}"/></g:if><g:else><i class="bi bi-door-open"></i></g:else></div><div class="mn-room-card-body"><div class="d-flex justify-content-between gap-2"><div><small class="mn-muted">${room.roomNumber}</small><h3 dir="auto">${room.displayName()}</h3></div><span class="mn-status ${room.active?'mn-status-success':'mn-status-neutral'}">${room.active?'متاحة':'معطلة'}</span></div><div class="mn-room-specs"><span><i class="bi bi-people"></i> ${room.capacity}</span><span><ui:money value="${room.pricePerHour}"/>/ساعة</span><g:if test="${room.location}"><span>${room.location}</span></g:if></div><div class="mt-3 d-flex gap-2"><g:link action="show" id="${room.id}" class="mn-btn mn-btn-light mn-btn-sm">تفاصيل</g:link><g:link action="edit" id="${room.id}" class="mn-btn mn-btn-light mn-btn-sm">تعديل</g:link></div></div></article></g:each></div><g:if test="${!studyRoomList}"><div class="mn-empty">لا توجد غرف بعد.</div></g:if></div></section></body></html>
