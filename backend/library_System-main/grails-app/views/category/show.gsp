<!doctype html><html><head><meta name="layout" content="main"/><title>${category?.name} | المنارة</title></head><body><section class="mn-page"><div class="container"><div class="mn-page-head"><div><span class="mn-kicker">مسار قراءة</span><h1 dir="auto">${category?.name}</h1><p>${category?.description ?: 'لم يُضف وصف لهذا القسم بعد.'}</p></div><div class="mn-toolbar"><g:link action="index" class="mn-btn mn-btn-light">الأقسام</g:link><sec:ifAnyGranted roles="ROLE_ADMIN"><g:link action="edit" id="${category.id}" class="mn-btn mn-btn-primary">تعديل</g:link></sec:ifAnyGranted></div></div>
<div class="mn-panel mb-4"><div class="mn-panel-body d-flex gap-3 flex-wrap"><span class="mn-meta-chip">${bookList?.size() ?: 0} كتاب</span><span class="mn-meta-chip">${category.active?'قسم فعال':'قسم معطل'}</span></div></div>
<div class="mn-catalog-grid"><g:each in="${bookList}" var="book"><article class="mn-catalog-card"><div class="mn-room-image" style="aspect-ratio:4/3"><g:if test="${book.coverData || book.externalCoverUrl}"><img src="${createLink(controller:'book',action:'cover',id:book.id)}" alt="${book.title}"/></g:if><g:else><i class="bi bi-book"></i></g:else></div><div class="mn-room-card-body"><small class="mn-muted" dir="auto">${book.author?.name}</small><h3 dir="auto">${book.title}</h3><g:link controller="book" action="show" id="${book.id}" class="mn-btn mn-btn-light mn-btn-sm">عرض الكتاب</g:link></div></article></g:each></div><g:if test="${!bookList}"><div class="mn-empty">لا توجد كتب في هذا القسم حاليًا.</div></g:if>
<sec:ifAnyGranted roles="ROLE_ADMIN"><g:form action="delete" id="${category.id}" method="DELETE" class="mt-4"><button class="mn-btn mn-btn-danger" data-confirm="حذف القسم؟ لا يمكن حذفه إذا كانت هناك كتب مرتبطة به.">حذف القسم</button></g:form></sec:ifAnyGranted>
</div></section></body></html>
