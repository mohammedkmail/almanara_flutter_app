<!doctype html><html><head><meta name="layout" content="main"/><title>استعارة ${borrowing?.bookCopy?.book?.title}</title></head><body><section class="mn-page"><div class="container"><div class="mn-page-head"><div><span class="mn-kicker">استعارة #${borrowing?.id}</span><h1 dir="auto">${borrowing?.bookCopy?.book?.title}</h1><p>النسخة ${borrowing?.bookCopy?.copyCode}</p></div><g:link action="index" class="mn-btn mn-btn-light">الاستعارات</g:link></div>
<div class="mn-form-shell"><div class="mn-panel"><div class="mn-panel-body"><div class="row g-4"><div class="col-md-6"><small class="mn-muted">المستخدم</small><strong class="d-block" dir="auto">${borrowing.user?.fullName ?: borrowing.user?.username}</strong></div><div class="col-md-6"><small class="mn-muted">الحالة</small><div><ui:status value="${borrowing.status}"/></div></div><div class="col-md-6"><small class="mn-muted">تاريخ الاستلام الفعلي</small><strong class="d-block">${borrowing.borrowDate ? g.formatDate(date: borrowing.borrowDate, format: 'dd/MM/yyyy HH:mm') : ''}</strong></div><div class="col-md-6"><small class="mn-muted">موعد الإرجاع</small><strong class="d-block">${borrowing.dueDate ? g.formatDate(date: borrowing.dueDate, format: 'dd/MM/yyyy') : ''}</strong></div><div class="col-md-6"><small class="mn-muted">مصدر العملية</small><strong class="d-block"><ui:label value="${borrowing.origin}"/> — <ui:label value="${borrowing.fulfillmentMethod}"/></strong></div><div class="col-md-6"><small class="mn-muted">الغرامة الحالية</small><strong class="d-block"><ui:money value="${borrowing.lateFee}"/></strong></div><g:if test="${borrowing.returnDate}"><div class="col-md-6"><small class="mn-muted">تاريخ الإرجاع</small><strong class="d-block">${borrowing.returnDate ? g.formatDate(date: borrowing.returnDate, format: 'dd/MM/yyyy HH:mm') : ''}</strong></div></g:if><g:if test="${payment}"><div class="col-md-6"><small class="mn-muted">مرجع الدفع</small><g:link controller="payment" action="show" id="${payment.id}" class="d-block">${payment.referenceCode}</g:link></div></g:if></div></div></div><aside class="mn-form-aside"><g:if test="${isAdmin && borrowing.status in ['ACTIVE','OVERDUE']}"><div class="mn-panel"><div class="mn-panel-body"><strong>إرجاع النسخة</strong><p class="mn-muted mt-2">عند الإرجاع تصبح النسخة متاحة، وإذا هناك قائمة انتظار يحجزها النظام لأول شخص تلقائيًا.</p><g:form action="returnBook" id="${borrowing.id}" method="POST"><button class="mn-btn mn-btn-primary w-100">تسجيل الإرجاع</button></g:form></div></div></g:if><g:else><div class="mn-panel"><div class="mn-panel-body"><strong>مدة الإعارة</strong><p class="mn-muted mb-0 mt-2">تبدأ من لحظة التسليم الفعلي وتستمر 14 يومًا. إذا تجاوز موعد الإرجاع تظهر الاستعارة كمتأخرة وتُحسب الغرامة عند الإرجاع.</p></div></div></g:else></aside></div></div></section></body></html>
