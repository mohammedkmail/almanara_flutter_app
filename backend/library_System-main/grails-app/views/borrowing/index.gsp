<!doctype html><html><head><meta name="layout" content="main"/><title>الاستعارات | المنارة</title></head><body><section class="mn-page"><div class="container"><div class="mn-page-head"><div><span class="mn-kicker">الإعارة الورقية</span><h1>${isAdmin?'إدارة الاستعارات':'استعاراتي'}</h1><p>${isAdmin?'تابع الاستعارات الفعلية بعد تسليم النسخ، وسجّل استعارة مباشرة من الكاونتر عند الحاجة.':'مدة الاستعارة تبدأ عند استلام الكتاب فعليًا، وليس عند الحجز أو الدفع.'}</p></div></div>
<g:if test="${isAdmin}"><div class="mn-form-section mb-4"><div class="d-flex justify-content-between align-items-start flex-wrap gap-3"><div><h2>استعارة مباشرة من الكاونتر</h2><p>للمستخدم الذي حضر للمكتبة واختار نسخة متاحة مباشرة.</p></div></div><g:if test="${userList && availableCopyList}"><g:form action="borrow" method="POST"><div class="row g-3"><div class="col-md-4 mn-field"><label>المستخدم</label><g:select name="userId" from="${userList}" optionKey="id" optionValue="displayName" noSelection="${['':'اختر المستخدم']}" class="form-select" required="required"/></div><div class="col-md-4 mn-field"><label>نسخة الكتاب</label><select name="bookCopyId" class="form-select" required><option value="">اختر النسخة</option><g:each in="${availableCopyList}" var="copy"><option value="${copy.id}">${copy.book?.title} — ${copy.copyCode}</option></g:each></select></div><div class="col-md-2 mn-field"><label>الدفع</label><select name="paymentMethod" class="form-select"><option value="CASH">نقدي</option><option value="CARD">بطاقة كاونتر</option></select></div><div class="col-md-2 d-flex align-items-end"><button class="mn-btn mn-btn-primary w-100">تسجيل</button></div><div class="col-12 mn-field"><label>ملاحظات</label><input name="notes" class="form-control" dir="auto"/></div></div></g:form></g:if><g:else><div class="alert alert-info mb-0">يجب وجود مستخدم عادي ونسخة كتاب متاحة لتسجيل استعارة مباشرة.</div></g:else></div></g:if>
<div class="mn-panel"><div class="table-responsive"><table class="mn-data-table"><thead><tr><g:if test="${isAdmin}"><th>المستخدم</th></g:if><th>الكتاب والنسخة</th><th>بدأت</th><th>موعد الإرجاع</th><th>الحالة</th><th>الغرامة</th><th></th></tr></thead><tbody><g:each in="${borrowingList}" var="b"><tr><g:if test="${isAdmin}"><td dir="auto">${b.user?.fullName ?: b.user?.username}</td></g:if><td><div class="mn-entity"><g:if test="${b.bookCopy?.book?.coverData || b.bookCopy?.book?.externalCoverUrl}"><img class="mn-entity-avatar" src="${createLink(controller:'book',action:'cover',id:b.bookCopy.book.id)}"/></g:if><div><strong dir="auto">${b.bookCopy?.book?.title}</strong><small>${b.bookCopy?.copyCode}</small></div></div></td><td>${b.borrowDate ? g.formatDate(date: b.borrowDate, format: 'dd/MM/yyyy') : ''}</td><td>${b.dueDate ? g.formatDate(date: b.dueDate, format: 'dd/MM/yyyy') : ''}</td><td><ui:status value="${b.status}"/></td><td><ui:money value="${b.lateFee}"/></td><td><g:link action="show" id="${b.id}" class="mn-btn mn-btn-light mn-btn-sm">تفاصيل</g:link></td></tr></g:each><g:if test="${!borrowingList}"><tr><td colspan="7" class="mn-empty">لا توجد استعارات بعد.</td></tr></g:if></tbody></table></div></div></div></section></body></html>
