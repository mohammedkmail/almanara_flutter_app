<!doctype html><html><head><meta name="layout" content="main"/><title>طلب ${purchase?.book?.title} | المنارة</title></head><body><section class="mn-page"><div class="container"><div class="mn-page-head"><div><span class="mn-kicker">طلب شراء #${purchase?.id}</span><h1 dir="auto">${purchase?.book?.title}</h1><p dir="auto">${purchase?.book?.author?.name}</p></div><g:link action="index" class="mn-btn mn-btn-light">المشتريات</g:link></div>
<div class="mn-detail-hero"><div class="mn-detail-media"><g:if test="${purchase.book?.coverData || purchase.book?.externalCoverUrl}"><img src="${createLink(controller:'book',action:'cover',id:purchase.book.id)}"/></g:if><g:else><i class="bi bi-book fs-1"></i></g:else></div><div class="mn-detail-copy"><span class="mn-kicker"><ui:label value="${purchase.purchaseType}"/></span><h1 dir="auto">${purchase.book?.title}</h1><div class="mn-meta-row"><ui:status value="${purchase.status}"/><span class="mn-meta-chip"><ui:label value="${purchase.fulfillmentMethod}"/></span><span class="mn-meta-chip"><ui:label value="${purchase.fulfillmentStatus}"/></span></div></div></div>
<div class="mn-form-shell mt-4"><div class="mn-panel"><div class="mn-panel-body"><div class="row g-4"><div class="col-md-6"><small class="mn-muted">المستخدم</small><strong class="d-block" dir="auto">${purchase.user?.fullName ?: purchase.user?.username}</strong></div><div class="col-md-6"><small class="mn-muted">الكمية</small><strong class="d-block">${purchase.quantity}</strong></div><div class="col-md-6"><small class="mn-muted">سعر الوحدة</small><strong class="d-block"><ui:money value="${purchase.unitPrice}"/></strong></div><div class="col-md-6"><small class="mn-muted">الإجمالي</small><strong class="d-block"><ui:money value="${purchase.totalAmount}"/></strong></div><g:if test="${purchase.deliveryAddress}"><div class="col-12"><small class="mn-muted">عنوان التوصيل</small><p class="mb-0" dir="auto">${purchase.deliveryAddress}</p></div></g:if><g:if test="${payment}"><div class="col-12"><small class="mn-muted">مرجع الدفع</small><g:link controller="payment" action="show" id="${payment.id}" class="d-block" dir="ltr">${payment.referenceCode}</g:link></div></g:if></div></div></div>
<aside class="mn-form-aside"><g:if test="${isAdmin && purchase.status=='COMPLETED' && purchase.purchaseType=='PHYSICAL'}"><div class="mn-panel"><div class="mn-panel-body"><strong>إدارة التجهيز</strong><p class="mn-muted mt-2">الدفع تم. الآن حدّث فقط مرحلة التسليم الواقعية.</p><g:form action="updateFulfillment" id="${purchase.id}" method="POST"><div class="mn-field"><label>الحالة الجديدة</label><select name="fulfillmentStatus" class="form-select"><g:if test="${purchase.fulfillmentMethod=='DELIVERY'}"><option value="PREPARING">قيد التجهيز</option><option value="OUT_FOR_DELIVERY">خرج للتوصيل</option><option value="FULFILLED">تم التسليم</option></g:if><g:else><option value="PREPARING">قيد التجهيز</option><option value="READY_FOR_PICKUP">جاهز للاستلام</option><option value="FULFILLED">تم الاستلام</option></g:else></select></div><button class="mn-btn mn-btn-primary w-100">تحديث</button></g:form></div></div></g:if><g:else><div class="mn-panel"><div class="mn-panel-body"><strong>حالة الطلب</strong><p class="mn-muted mt-2 mb-0">الشراء الرقمي يُفعّل مباشرة بعد الدفع. أما الورقي فيتحرك بين التجهيز والاستلام أو التوصيل.</p></div></div></g:else></aside></div>
</div></section></body></html>
