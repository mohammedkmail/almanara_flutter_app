<!doctype html><html><head><meta name="layout" content="main"/><title>المشتريات | المنارة</title></head><body><section class="mn-page"><div class="container"><div class="mn-page-head"><div><span class="mn-kicker">الطلبات والمبيعات</span><h1>${isAdmin?'إدارة المشتريات':'مشترياتي'}</h1><p>${isAdmin?'طلبات الأونلاين وعمليات الكاونتر في مسار واحد، مع حالة الدفع والتجهيز والاستلام.':'تابع مشترياتك الورقية والرقمية وحالة الاستلام أو التوصيل.'}</p></div><g:if test="${isAdmin}"><g:link action="counterSale" class="mn-btn mn-btn-primary"><i class="bi bi-shop"></i> بيع من الكاونتر</g:link></g:if></div>
<div class="mn-panel"><div class="table-responsive"><table class="mn-data-table"><thead><tr><g:if test="${isAdmin}"><th>المستخدم</th></g:if><th>الكتاب</th><th>النوع</th><th>الكمية</th><th>الإجمالي</th><th>الدفع</th><th>التجهيز</th><th></th></tr></thead><tbody><g:each in="${purchaseList}" var="p"><tr><g:if test="${isAdmin}"><td dir="auto">${p.user?.fullName ?: p.user?.username}</td></g:if><td><div class="mn-entity"><g:if test="${p.book?.coverData || p.book?.externalCoverUrl}"><img class="mn-entity-avatar" src="${createLink(controller:'book',action:'cover',id:p.book.id)}"/></g:if><div><strong dir="auto">${p.book?.title}</strong><small dir="auto">${p.book?.author?.name}</small></div></div></td><td><ui:label value="${p.purchaseType}"/></td><td>${p.quantity}</td><td><strong><ui:money value="${p.totalAmount}"/></strong></td><td><ui:status value="${p.status}"/></td><td><ui:label value="${p.fulfillmentStatus}"/></td><td><g:link action="show" id="${p.id}" class="mn-btn mn-btn-light mn-btn-sm">تفاصيل</g:link></td></tr></g:each><g:if test="${!purchaseList}"><tr><td colspan="8" class="mn-empty"><i class="bi bi-bag"></i>لا توجد مشتريات بعد.</td></tr></g:if></tbody></table></div></div></div></section></body></html>
