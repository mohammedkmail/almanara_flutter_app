<!doctype html><html><head><meta name="layout" content="main"/><title>حجوزات الغرف | المنارة</title></head><body><section class="mn-page"><div class="container"><div class="mn-page-head"><div><span class="mn-kicker">غرف الدراسة</span><h1>${isAdmin?'إدارة حجوزات الغرف':'حجوزاتي'}</h1><p>${isAdmin?'الحجوزات الظاهرة هنا مؤكدة بعد الدفع فقط.':'كل حجز ظاهر هنا تم تأكيده بعد نجاح الدفع، ولا توجد حجوزات معلقة.'}</p></div><g:if test="${!isAdmin}"><g:link action="create" class="mn-btn mn-btn-primary"><i class="bi bi-plus-lg"></i> حجز غرفة</g:link></g:if></div>
<div class="mn-panel"><div class="table-responsive"><table class="mn-data-table"><thead><tr><g:if test="${isAdmin}"><th>المستخدم</th></g:if><th>الغرفة</th><th>البداية</th><th>النهاية</th><th>السعر</th><th>الخصم</th><th>الحالة</th><th></th></tr></thead><tbody><g:each in="${roomReservationList}" var="r"><tr><g:if test="${isAdmin}"><td dir="auto">${r.user?.fullName ?: r.user?.username}</td></g:if><td><div class="mn-entity"><g:if test="${r.studyRoom?.imageData}"><img class="mn-entity-avatar" style="width:58px;height:44px" src="${createLink(controller:'studyRoom',action:'photo',id:r.studyRoom.id)}"/></g:if><div><strong dir="auto">${r.studyRoom?.displayName()}</strong><small>${r.studyRoom?.location ?: 'الغرفة '+r.studyRoom?.roomNumber}</small></div></div></td><td><g:formatDate date="${r.startTime}" format="dd/MM/yyyy HH:mm"/></td><td><g:formatDate date="${r.endTime}" format="dd/MM/yyyy HH:mm"/></td><td><strong><ui:money value="${r.totalPrice}"/></strong></td><td>${r.discountPercentage ?: 0}%</td><td><ui:status value="${r.status}"/></td><td><g:link action="show" id="${r.id}" class="mn-btn mn-btn-light mn-btn-sm">تفاصيل</g:link></td></tr></g:each><g:if test="${!roomReservationList}"><tr><td colspan="8" class="mn-empty"><i class="bi bi-door-open"></i>لا توجد حجوزات غرف بعد.</td></tr></g:if></tbody></table></div></div></div></section></body></html>
