<g:form action="${formAction}" id="${discountRule?.id}" method="${formAction=='update'?'PUT':'POST'}"><div class="mn-form-shell"><div class="mn-form-section"><div class="mn-field"><label>اسم القاعدة</label><input class="form-control" name="name" value="${discountRule?.name ?: ''}" placeholder="مثال: خصم الأسبوع" required/></div><div class="row g-3"><div class="col-md-6 mn-field"><label>الحد الأدنى بالساعات</label><input type="number" min="0" class="form-control" name="minHours" value="${discountRule?.minHours ?: 0}" required/></div><div class="col-md-6 mn-field"><label>الحد الأعلى بالساعات</label><input type="number" min="1" class="form-control" name="maxHours" value="${discountRule?.maxHours ?: ''}" placeholder="اتركه فارغًا بدون حد"/></div><div class="col-md-6 mn-field"><label>نسبة الخصم %</label><input type="number" min="0" max="100" step="0.01" class="form-control" name="percentage" value="${discountRule?.percentage ?: 0}" required/></div><div class="col-md-6 mn-field"><label>الأولوية</label><input type="number" min="0" class="form-control" name="priority" value="${discountRule?.priority ?: 100}" required/></div></div><div class="form-check"><input class="form-check-input" type="checkbox" name="active" value="true" id="active" ${discountRule?.active != false?'checked':''}/><label class="form-check-label" for="active">القاعدة فعالة</label></div><div class="mn-form-actions"><button class="mn-btn mn-btn-primary">حفظ</button><g:link action="index" class="mn-btn mn-btn-light">إلغاء</g:link></div></div><aside class="mn-form-aside"><div class="mn-panel"><div class="mn-panel-body"><strong>سياسة مقترحة</strong><p class="mn-muted mb-0 mt-2">أقل من يوم بدون خصم، 1–3 أيام 5%، 4–7 أيام 10%، 8–14 يوم 15%، 15–30 يوم 20%. يمكنك تغييرها من هنا.</p></div></div></aside></div></g:form>
